# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_ENV=development
APP_URL=http://localhost/

# Database Configuration
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# API authentication secrets (use separate random values of at least 32 characters)
JWT_SECRET=
REFRESH_TOKEN_KEY=
MIGRATION_SECRET=

# Comma-separated exact frontend origins; add your deployed Vercel URL in Render
CORS_ORIGINS=http://localhost:5173
